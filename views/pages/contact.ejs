<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<main class="container main-content">
  <h1>İletişim</h1>
  <p class="section-lead">Hukuki durumunuzu değerlendirmek için bizimle iletişime geçebilirsiniz.</p>

  <div class="contact-layout">
    <div class="contact-form-col">
      <% if (success) { %>
      <div class="alert success">Mesajınız gönderildi. En kısa sürede size dönüş yapılacaktır.</div>
      <% } %>
      <% if (error === 'validation') { %>
      <div class="alert error">Lütfen tüm alanları doldurun.</div>
      <% } %>
      <% if (error === 'config') { %>
      <div class="alert error">İletişim e-postası şu an yapılandırılmamış. Lütfen daha sonra tekrar deneyin veya doğrudan arayın.</div>
      <% } %>
      <% if (error === 'send') { %>
      <div class="alert error">Mesaj gönderilirken bir sorun oluştu. Bir süre sonra tekrar deneyin veya telefon ile ulaşın.</div>
      <% } %>

      <form method="POST" action="/contact" class="form-card">
        <label>Ad Soyad<input name="name" type="text" required autocomplete="name" /></label>
        <label>Telefon<input name="phone" type="tel" required autocomplete="tel" /></label>
        <label>E-posta<input name="email" type="email" required autocomplete="email" /></label>
        <label>Mesaj<textarea name="message" rows="5" required></textarea></label>
        <button class="btn" type="submit">Gönder</button>
      </form>
    </div>

    <aside class="contact-info-col">
      <div class="card contact-info-card">
        <h2 class="contact-info-card__title">Ofis Bilgileri</h2>
        <ul class="contact-info-list">
          <li class="contact-info-item">
            <span class="contact-info-label">Telefon</span>
            <a href="tel:+905362372757" class="contact-info-value">+90 536 237 27 57</a>
          </li>
          <li class="contact-info-item">
            <span class="contact-info-label">E-posta</span>
            <a href="mailto:info@enesaktashukuk.com" class="contact-info-value">info@enesaktashukuk.com</a>
          </li>
          <li class="contact-info-item">
            <span class="contact-info-label">Adres</span>
            <a class="contact-info-value" href="https://www.google.com/maps/place/Avukat+Enes+AKTA%C5%9E+|+Eski%C5%9Fehir+%C4%B0cra+Avukat%C4%B1+-+Bo%C5%9Fanma+Avukat%C4%B1-+Kira+Avukat%C4%B1+-+Haciz+Kald%C4%B1rma+-+Eski%C5%9Fehir+%C4%B0cra+%C4%B0tiraz/@39.7642986,30.535547,18.21z/data=!4m10!1m2!2m1!1savukat+enes!3m6!1s0x14cc3dc07c8f06f9:0xbd73553a2af7aa41!8m2!3d39.7645919!4d30.5363376!15sCgthdnVrYXQgZW5lc1oNIgthdnVrYXQgZW5lc5IBEGRpdm9yY2VfYXR0b3JuZXmaAURDaTlEUVVsUlFVTnZaRU5vZEhsalJqbHZUMnhTVW1GVVNUUmxiR1F4VWpGc1VGcHNRWGRqVjBwNFRXa3hZV0V4UlJBQuABAPoBBAgAEDY!16s%2Fg%2F11kjcth36c?entry=ttu&g_ep=EgoyMDI2MDcyMS4wIKXMDSoASAFQAw%3D%3D">Alanönü, Gayret Sk. No:2/2, 26030 Odunpazarı/Eskişehir</a>
          </li>
          <li class="contact-info-item">
            <span class="contact-info-label">Çalışma Saatleri</span>
            <span class="contact-info-value">Pts &ndash; Cum: 09:00 &ndash; 18:30</span>
          </li>
        </ul>
      </div>
      <div class="card contact-note-card">
        <p><strong>İlk görüşme</strong> için formu doldurun; avukatımız en geç 1 iş günü içinde sizinle iletişime geçecektir.</p>
      </div>
    </aside>
  </div>

  <div class="map-section">
    <h2 class="map-section__title">Konumumuz</h2>
    <div class="map-frame">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1327.258199405724!2d30.53554695332375!3d39.76429861716113!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cc3dc07c8f06f9%3A0xbd73553a2af7aa41!2zQXZ1a2F0IEVuZXMgQUtUQcWeIHwgRXNracWfZWhpciDEsGNyYSBBdnVrYXTEsSAtIEJvxZ9hbm1hIEF2dWthdMSxLSBLaXJhIEF2dWthdMSxIC0gSGFjaXogS2FsZMSxcm1hIC0gRXNracWfZWhpciDEsGNyYSDEsHRpcmF6!5e0!3m2!1str!2str!4v1784883038944!5m2!1str!2str"
        title="Av. Enes Aktaş Ofis Konumu"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</main>
<%- include("../partials/footer") %>
