<header class="site-header">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <img src="/images/logo.svg" alt="" class="brand-logo" width="36" height="36" aria-hidden="true" />
      Av. Enes Aktaş
    </a>
    <a class="nav-call nav-call--phone" href="tel:+905362372757" aria-label="Hemen ara: +90 536 237 27 57">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span class="nav-call__text">Bizi Arayın</span>
    </a>
    <a class="nav-call nav-call--mail" href="mailto:info@enesaktashukuk.com" aria-label="Bize e-posta gönderin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
      <span class="nav-call__text">Bize Ulaşın</span>
    </a>
    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-label="Menüyü aç veya kapat"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
    <div class="nav-backdrop" id="nav-backdrop" hidden aria-hidden="true"></div>
    <nav id="site-nav" class="site-nav" aria-label="Ana menü">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Ana Sayfa</a>
      <a class="<%= currentPath === '/about' ? 'active' : '' %>" href="/about">Hakkında</a>
      <a class="<%= currentPath === '/services' ? 'active' : '' %>" href="/services">Hizmetler</a>
      <div class="site-nav-highlight">
        <a class="site-nav-contact <%= currentPath === '/contact' ? 'active' : '' %>" href="/contact">İletişim</a>
        <a class="site-nav-quick-call" href="tel:+905362372757" aria-label="Hemen ara: +90 536 237 27 57">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </a>
      </div>
      <a class="<%= currentPath.startsWith('/blog') ? 'active' : '' %>" href="/blog">Blog</a>
    </nav>
  </div>
</header>
