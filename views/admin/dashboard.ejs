<%- include("../partials/head") %>
<%- include("../partials/nav") %>
<main class="container admin-dashboard">

  <div class="admin-header">
    <div>
      <h1>Blog Yönetimi</h1>
      <p class="section-lead">Buradan yazı ekleyebilir ve silebilirsiniz.</p>
    </div>
    <form method="POST" action="/admin/logout">
      <button type="submit" class="btn-logout">Çıkış Yap</button>
    </form>
  </div>

  <div class="admin-layout">
    <section class="admin-form-section">
      <h2>Yeni Yazı Ekle</h2>

      <% if (error) { %>
      <div class="admin-alert-error"><%= error %></div>
      <% } %>

      <form class="admin-form" method="POST" action="/admin/posts">
        <label>
          Başlık
          <input name="title" type="text" value="<%= formValues.title || '' %>" required placeholder="Yazı başlığı" />
        </label>
        <label>
          Özet
          <textarea name="summary" rows="3" required placeholder="Kısa açıklama (blog listesinde görünür)"><%= formValues.summary || '' %></textarea>
        </label>
        <label>
          İçerik
          <textarea name="content" rows="10" required placeholder="Yazı içeriği. Paragraf için boş satır bırakın."><%= formValues.content || '' %></textarea>
        </label>
        <button type="submit" class="btn-publish">Yazıyı Yayınla</button>
      </form>
    </section>

    <section class="admin-posts-section">
      <h2>Mevcut Yazılar (<%= posts.length %>)</h2>
      <% if (posts.length === 0) { %>
      <p class="admin-empty">Henüz yazı yok.</p>
      <% } else { %>
      <ul class="admin-post-list">
        <% posts.forEach((post) => { %>
        <li class="admin-post-item">
          <div class="admin-post-info">
            <strong><%= post.title %></strong>
            <span><%= post.publishedAt %></span>
          </div>
          <div class="admin-post-actions">
            <a href="/blog/<%= post.slug %>" target="_blank" class="btn-view">Görüntüle</a>
            <form method="POST" action="/admin/posts/<%= post.id %>/delete" onsubmit="return confirm('Bu yazıyı silmek istediğinize emin misiniz?')">
              <button type="submit" class="btn-delete">Sil</button>
            </form>
          </div>
        </li>
        <% }) %>
      </ul>
      <% } %>
    </section>
  </div>

</main>
<%- include("../partials/footer") %>
